# ============================================================
# CCTV Enforcement — production environment file
# Copy to .env, fill secrets, chmod 600.
# ============================================================

# --- environment metadata ----------------------------------------------------
ENVIRONMENT=production               # development | staging | production
DEPLOYMENT_ID=hyd-cyberabad-01       # appears in logs and evidence metadata
TIMEZONE=Asia/Kolkata

# --- storage -----------------------------------------------------------------
EVIDENCE_DIR=/var/lib/cctv/evidence
EVIDENCE_BACKEND=local               # local | s3
S3_BUCKET=
S3_REGION=ap-south-1
S3_PREFIX=evidence/
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- database (Postgres in production; SQLite for offline dev only) ---------
DATABASE_URL=postgresql+psycopg2://cctv:CHANGE_ME@db:5432/cctv
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# --- redis (rate limiting, distributed locks, alert dedup) -------------------
REDIS_URL=redis://redis:6379/0

# --- model weights -----------------------------------------------------------
DETECTOR_WEIGHTS=/var/lib/cctv/models/yolo11n.engine
HELMET_WEIGHTS=/var/lib/cctv/models/helmet.engine
PLATE_WEIGHTS=/var/lib/cctv/models/plate.engine
OCR_LANG=en

# --- inference ---------------------------------------------------------------
DEVICE=cuda:0
MAX_FPS=15
DET_CONF=0.35
OCR_AUTO_ACCEPT=0.80

# --- auth (JWT) --------------------------------------------------------------
# 64+ random hex chars. Generate: openssl rand -hex 48
JWT_SECRET=CHANGE_ME_TO_64_HEX_CHARS
JWT_ISSUER=cctv-enforcement
JWT_AUDIENCE=cctv-operators
JWT_TTL_MINUTES=480
BOOTSTRAP_ADMIN_EMAIL=admin@traffic.example.in
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_STRONG

# --- evidence integrity (digital signature on every event) -------------------
# Generate keypair:
#   openssl genpkey -algorithm Ed25519 -out evidence_signing.key
#   openssl pkey -in evidence_signing.key -pubout -out evidence_signing.pub
EVIDENCE_SIGNING_KEY_PATH=/etc/cctv/evidence_signing.key
EVIDENCE_SIGNING_PUBKEY_PATH=/etc/cctv/evidence_signing.pub

# --- observability -----------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json                      # json | console
SENTRY_DSN=                          # optional; production crash reporting
PROMETHEUS_PORT=9090                 # exposed by both pipeline and api
METRICS_AUTH_TOKEN=CHANGE_ME

# --- API server --------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
ALLOWED_ORIGINS=https://review.traffic.example.in
SESSION_COOKIE_SECURE=true
RATE_LIMIT_PER_MINUTE=120

# --- retention ---------------------------------------------------------------
EVIDENCE_RETENTION_DAYS=180          # auto-archive/purge after this many days
ARCHIVE_S3_BUCKET=                   # if set, evidence is archived here before purge

# --- chalana integration (deferred wiring lives here for when it's ready) ---
CHALANA_API_URL=
CHALANA_API_KEY=
CHALANA_PUSH_ENABLED=false

# --- alerting ----------------------------------------------------------------
ALERT_WEBHOOK_URL=                   # Slack/Teams webhook for ops alerts
ALERT_CAMERA_OFFLINE_SECONDS=120
